# ---- HTTP ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# ---- MySQL -----------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=field_defib

# ---- JWT -------------------------------------------------------------------
# Two different secrets on purpose: a leak of one must not compromise the other.
# Generate your own with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---- service-to-service ----------------------------------------------------
# Must be identical to the value in mesh/.env
INTERNAL_SERVICE_KEY=dev_internal_key_change_me
# Where the dispatch/telemetry service lives. The admin panel asks it when each
# registered device last transmitted - a fact that lives only in MongoDB.
MESH_URL=http://localhost:5000

# ---- simulator admin (used by scripts/seed.js) -----------------------------
ADMIN_USERNAME=micha
ADMIN_PASSWORD=1234
