# ---- HTTP ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# ---- MongoDB ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=field_defib

# ---- the other server ------------------------------------------------------
API_URL=http://localhost:4000
# Must be identical to the value in api/.env
INTERNAL_SERVICE_KEY=dev_internal_key_change_me

# ---- dispatch tuning -------------------------------------------------------
# A heartbeat older than this is ignored by the radius search (minutes).
MAX_HEARTBEAT_AGE_MIN=180

# ---- bicycle routing -------------------------------------------------------
BROUTER_URL=https://brouter.de/brouter
ROUTING_TIMEOUT_MS=6000
